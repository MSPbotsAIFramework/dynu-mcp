# Optional overrides — dynu-mcp has no required env vars.
# Authentication is per-request via the X-Dynu-Api-Key header (a static
# Dynu API key, found in the API Credentials area of the Dynu control
# panel). This server forwards it verbatim as the upstream "API-Key"
# header on every call, matching MSPbots' own configured header template
# ("value": "#{apiKey}") exactly.

MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0

# Fixed Dynu API base URL — override only if Dynu provisions a different
# endpoint for your organization.
# DYNU_BASE_URL=https://api.dynu.com/v2
